# Copy to .env and paste your key. .env is not committed.
# OpenRouter has no local port. This base URL is the whole address.
# Do not add /chat/completions; the app adds that.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Copy a model id that ends in :free from https://openrouter.ai/models?max_price=0
LLM_MODEL=
